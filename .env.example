# Personal Dashboard environment configuration.
# Copy this file to .env and fill in real values:
#   cp .env.example .env
# The root .env is consumed by docker compose (env_file for the backend
# service). Never commit the real .env.

# Outline API
OUTLINE_API_URL=https://xxxxx/api
OUTLINE_API_KEY=ol_api_your_key_here
# Optional: Specific document ID to fetch tasks from (UUID from document URL)
# If not set, fetches from all documents with tasks
# Get the UUID from: https://xxxxx/doc/task-dX8WroOpOn
OUTLINE_TASK_DOCUMENT_ID=xxxxx

# Google OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# When running via docker compose the frontend's nginx proxies /auth/* to the
# backend, so point the callback at the port you open in the browser (8081).
GOOGLE_REDIRECT_URI=http://localhost:8081/auth/google/callback
# For local dev (Vite at http://localhost:5173 proxying to cargo run):
# put this in a gitignored backend/.env, which must be a full copy of this root
# .env with only GOOGLE_REDIRECT_URI changed (dotenv loads one file, no merging):
# GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
# Register this URI in the Google console alongside the 8081 one.

# Security (generate one, e.g. with: openssl rand -hex 32)
SESSION_SECRET=generate-a-random-secret-string-here

# Server
PORT=3000
HOST=0.0.0.0
